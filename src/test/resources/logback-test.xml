<!-- Quiets Ktor test-host startup and CallLogging request chatter during tests. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{10} [%file:%line] - %msg%n%xEx</pattern>
        </encoder>
    </appender>

    <!-- Ktor logs app startup, connector binding, and (via CallLogging) every request at INFO. -->
    <logger name="io.ktor" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
